# =============================================================================
# KRNEL — tests/demo-concurrencia/.env.example
# Copia este archivo a `.env` (gitignored) y completa los valores reales.
# NUNCA pongas contraseñas ni tokens en el código ni en git — solo aquí.
# =============================================================================

# URL raíz del JupyterHub (sin slash final). En prod es https://<jupyterhub_domain>.
HUB_URL=https://jupyter.midominio.com

# Contraseña COMPARTIDA por todas las cuentas demo (demo-01..demo-NN).
# Mínimo 8 caracteres (NativeAuthenticator: minimum_password_length=8).
DEMO_PASSWORD=

# Cuántos "usuarios" simultáneos lanzar. El techo real lo fija la ResourceQuota
# del namespace jupyter (Fase 3). Empieza bajo y sube. Para una prueba de carga
# real con login incluido (Fase 10.3, ver README "Prueba de carga real"),
# confirmá primero el techo con la sonda k6 de tmp/capacity-probe/ (fuera de
# este árbol, con la cuota real el techo teórico del perfil de invitado es
# ~13, limitado por RAM) y usá ese número acá, no lo subas a ciegas.
DEMO_USER_COUNT=3

# Plantilla del username de cada cuenta demo. `{n}` se reemplaza por el índice
# con relleno de ceros a 2 dígitos (demo-01, demo-02, ...). Lo que pongas aquí
# DEBE coincidir línea a línea con files/allowlist.txt.
DEMO_USERNAME_TEMPLATE=demo-{n}

# display_name del perfil a elegir si el Hub muestra el formulario de perfiles.
# Vacío = primer perfil de la lista = "Efímero (Invitado)" (local[*], sin Spark).
# Para demostrar Spark: "Comunidad" o "Profesor" (requiere que un admin asigne
# el grupo a cada demo-NN antes de correr, y SPAWN_TIMEOUT_MS mayor).
# persistence.spec.ts (verify:persistence) EXIGE que esto apunte a un perfil
# con almacenamiento persistente propio (no el de invitado) — si queda vacío,
# ese test se salta solo en vez de dar un falso verde.
DEMO_PROFILE=

# Timeouts (ms). Generosos pero acotados. El primer spawn concurrente pagará el
# pull de la imagen all-spark-notebook (prePuller.hook está deshabilitado).
# Perfiles Spark: sube SPAWN_TIMEOUT_MS a 600000+.
LOGIN_TIMEOUT_MS=30000
SPAWN_TIMEOUT_MS=300000
EXEC_TIMEOUT_MS=60000

# slowMo (ms) SOLO para el proyecto `demo` (headed) — hace el video legible.
DEMO_SLOWMO_MS=150

# OPCIONAL — token de admin de JupyterHub con scope `servers`.
# Si se define, el afterEach/afterAll hace un barrido DELETE de servidores
# huérfanos vía REST API además del "Stop My Server" por UI.
# Generar en la UI de admin o: `kubectl -n jupyter exec deploy/hub -- \
#   jupyterhub token <admin_user>`
ADMIN_TOKEN=

# OPCIONAL — aviso por correo del resumen de cada corrida (smoke/concurrencia)
# a los administradores. Reusa el mismo criterio multi-admin que Alertmanager
# (Fase 4 del hardening), pero con SU PROPIA credencial SMTP — esta suite corre
# fuera de Ansible y no lee el Vault del clúster. Dejar cualquiera vacía = sin
# envío (best-effort: si falla el envío, la corrida y sus reportes en
# reports/ igual quedan bien).
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_SECURE=false
REPORT_SMTP_USER=
REPORT_SMTP_PASSWORD=
REPORT_EMAIL_FROM=
# Lista separada por comas.
REPORT_EMAIL_TO=
